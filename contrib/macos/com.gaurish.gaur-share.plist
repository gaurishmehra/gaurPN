<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gaurish.gaur-share</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/gaur-share</string>
    <string>-clipboard-source=poll</string>
    <string>daemon</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/gaur-share.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/gaur-share.log</string>
</dict>
</plist>
