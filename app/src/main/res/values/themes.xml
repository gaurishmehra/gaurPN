<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window background is the first frame the user sees. It carries the
         Bench background per mode so a light-theme launch never flashes black
         before Compose composes. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/bench_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
